# Olvana — environment variables. Copy to .env and fill in.
# Chain/contract facts (chain id, USDG, Morpho Blue, vault addresses) are NOT
# env vars: they live in packages/core/src/config.ts (run `pnpm config:todos`).

# ---- Chain -------------------------------------------------------------
# TODO: Robinhood Chain RPC endpoints (primary + fallback). May include an API key.
RPC_URL=
RPC_URL_FALLBACK=
# TODO: public RPC for the browser (wagmi). Do not put a secret key here.
NEXT_PUBLIC_RPC_URL=

# ---- Web ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://olvana.org
NEXT_PUBLIC_API_URL=http://localhost:4000
# TODO: WalletConnect Cloud project id (RainbowKit).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- API ---------------------------------------------------------------
API_PORT=4000
# Secret for SIWE sessions (long random string).
SESSION_SECRET=

# ---- Data --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olvana
REDIS_URL=redis://localhost:6379

# ---- Telegram ----------------------------------------------------------
# TODO: from @BotFather.
TELEGRAM_BOT_TOKEN=
# TODO: bot username without @ (used for t.me/<bot>?start=<code> links).
TELEGRAM_BOT_USERNAME=

# ---- Worker ------------------------------------------------------------
# Daily Telegram report, cron in DAILY_REPORT_TZ (HANDOFF §7.2: 09:00 WIB).
DAILY_REPORT_CRON=0 9 * * *
DAILY_REPORT_TZ=Asia/Jakarta
